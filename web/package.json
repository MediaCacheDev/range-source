{
  "name": "range-source-web",
  "version": "1.2.0",
  "description": "Range source and storage manager for video and other partial content on the web: reads files by offset through HTTP range requests, Blobs or your own source, and keeps what was read in OPFS, IndexedDB, the Cache API or memory under one size cap.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "module": "./dist/sw.mjs",
      "import": "./dist/sw.mjs",
      "require": "./dist/sw.js"
    },
    "./range-source-sw.js": "./dist/range-source-sw.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browsers": "npm run build && node test/browsers/worker.mjs",
    "serve": "node test/range-server.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "range-source",
    "range-requests",
    "http-range",
    "partial-content",
    "byte-range",
    "byte-source",
    "streaming",
    "video",
    "video-streaming",
    "video-cache",
    "media-cache",
    "storage",
    "offline",
    "opfs",
    "indexeddb",
    "cache-api",
    "cache"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaCacheDev/range-source.git",
    "directory": "web"
  },
  "homepage": "https://github.com/MediaCacheDev/range-source#readme",
  "bugs": {
    "url": "https://github.com/MediaCacheDev/range-source/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.62.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
