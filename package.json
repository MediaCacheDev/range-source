    "react-native.config.js",
    "LICENSE",
    "!android/build",
    "!android/*/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/local.properties",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/media3",
    "!android/src/androidTest",
    "!ios/Tests",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!react-native/android/.cxx",
