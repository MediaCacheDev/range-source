{
  "name": "react-native-range-source",
  "version": "1.0.0",
  "description": "Range source and storage manager for video and other partial content in React Native: the alpha-video players (react-native-alpha-video, react-native-alpha-video-gpu) read URLs through it by range, with read-ahead and retries, and keep what was read on disk or in memory under one size cap. Install it beside the player; there's nothing to call.",
  "main": "react-native/index.js",
  "types": "react-native/index.d.ts",
  "react-native": "react-native/index.js",
  "files": [
    "react-native",
    "android",
    "native/include",
    "native/src",
    "ios",
    "react-native-range-source.podspec",
    "react-native.config.js",
    "CHANGELOG.md",
    "LICENSE",
    "!android/build",
    "!android/*/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/local.properties",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/media3",
    "!android/src/androidTest",
    "!ios/Tests",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!react-native/android/.cxx",
    "!.DS_Store"
  ],
  "scripts": {
    "test": "npm run test:native && npm run test:web",
    "test:native": "cmake -S native -B native/build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build native/build && ctest --test-dir native/build --output-on-failure",
    "test:web": "npm --prefix web test",
    "test:web:browsers": "npm --prefix web run test:browsers",
    "test:ios": "scripts/test-ios.sh",
    "test:android": "cd android && ./gradlew connectedDebugAndroidTest :media3:assembleDebug",
    "test:all": "npm test && npm run test:ios && npm run test:android"
  },
  "keywords": [
    "react-native",
    "range-source",
    "range-requests",
    "http-range",
    "partial-content",
    "byte-range",
    "streaming",
    "video",
    "video-streaming",
    "video-cache",
    "media-cache",
    "storage",
    "offline",
    "cache",
    "alpha-video",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaCacheDev/range-source.git"
  },
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MediaCacheDev/range-source/issues"
  },
  "homepage": "https://github.com/MediaCacheDev/range-source#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react-native": "*"
  }
}
